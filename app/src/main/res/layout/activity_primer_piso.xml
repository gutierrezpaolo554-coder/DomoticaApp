<?xml version="1.0" encoding="utf-8"?>
<!-- activity_primer_piso.xml - Pantalla del Primer Piso (Sala) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo de pantalla -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_primer_piso"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo Primer Piso" />

    <!-- Overlay oscuro -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Etiqueta del piso -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIMER PISO - Sala"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="#80000000"
            android:padding="12dp"
            android:layout_marginBottom="40dp" />

        <!-- Card de controles -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#80000000"
            android:padding="20dp">

            <!-- Control de Luz -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="30dp">

                <ImageButton
                    android:id="@+id/btnLuzP1"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/luz_off"
                    android:background="#0f3460"
                    android:scaleType="fitCenter"
                    android:contentDescription="Luz Primer Piso" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luz"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seekLuzP1"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Control de Enchufe -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnEnchufeP1"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/enchufe_off"
                    android:background="#0f3460"
                    android:scaleType="fitCenter"
                    android:contentDescription="Enchufe Primer Piso" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enchufe"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>