<?xml version="1.0" encoding="utf-8"?>
<!-- activity_main.xml - Pantalla principal de la aplicación Domótica -->
<!-- Contiene el título, logo UJCV y botones de navegación -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Título de la aplicación -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOMOTICA APP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="#16213e"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:textAlignment="center" />

        <!-- Imagen UJCV - Click largo muestra información de la app -->
        <ImageView
            android:id="@+id/imgUJCV"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ujcv_logo"
            android:layout_marginBottom="30dp"
            android:contentDescription="Logo UJCV" />

        <!-- Botón Casa -->
        <Button
            android:id="@+id/btnCasa"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🏠 Casa"
            android:textSize="20sp"
            android:backgroundTint="#0f3460"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp" />

        <!-- Botón Primer Piso -->
        <Button
            android:id="@+id/btnPrimerPiso"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="1️⃣ Primer Piso"
            android:textSize="20sp"
            android:backgroundTint="#533483"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp" />

        <!-- Botón Segundo Piso -->
        <Button
            android:id="@+id/btnSegundoPiso"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="2️⃣ Segundo Piso"
            android:textSize="20sp"
            android:backgroundTint="#533483"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp" />

        <!-- Botón Tercer Piso -->
        <Button
            android:id="@+id/btnTercerPiso"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="3️ Tercer Piso"
            android:textSize="20sp"
            android:backgroundTint="#533483"
            android:textColor="#ffffff"
            android:layout_marginBottom="12dp" />

        <!-- Botón Exterior y Garaje -->
        <Button
            android:id="@+id/btnExteriorGaraje"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text=" Exterior y Garaje"
            android:textSize="20sp"
            android:backgroundTint="#e94560"
            android:textColor="#ffffff"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>