<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_exterior"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo Exterior y Garaje" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXTERIOR Y GARAJE"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="#80000000"
            android:padding="12dp"
            android:layout_marginBottom="40dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#80000000"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="30dp">

                <ImageButton
                    android:id="@+id/btnLuzExt"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/luz_off"
                    android:background="#0f3460"
                    android:scaleType="fitCenter"
                    android:contentDescription="Luz Exterior" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Luz Exterior"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seekLuzExt"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnEnchufeExt"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/enchufe_off"
                    android:background="#0f3460"
                    android:scaleType="fitCenter"
                    android:contentDescription="Enchufe Garaje" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enchufe Garaje"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>